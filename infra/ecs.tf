# Batch job, not a service.
#
# The app starts, does its work and exits. A service would read that exit as a
# crash and restart it in a loop, so this file has no aws_ecs_service on
# purpose: every run is one `RunTask` call, and each call is parameterised with
# containerOverrides (RUN_MODE, PAYLOAD, INPUT_KEY) instead of a new deploy.
#
# Where the network lives: a task definition cannot carry subnets, a security
# group or the public-IP flag. Those are arguments of the RunTask call itself,
# so section 3.5 of docs/verification.md shows them and the dispatcher (3.6)
# passes them. This file owns the part that is static: the task security group.

# Somewhere for the agent to write stdout/stderr. Retention is short on
# purpose: the app also emits its own JSON events, so these logs are the
# fallback, not the record.
resource "aws_cloudwatch_log_group" "app" {
  name              = local.log_group_name
  retention_in_days = 14
}

resource "aws_ecs_cluster" "app" {
  name = local.name_prefix

  # Cluster-level metrics (cpu/mem per task) in CloudWatch. Off by default
  # because CloudWatch charges per custom metric.
  setting {
    name  = "containerInsights"
    value = "enabled"
  }
}

# No ingress rules: nothing connects INTO a task. The egress rules below are the
# whole network policy, which makes it readable at a glance.
resource "aws_security_group" "task" {
  name        = "${local.name_prefix}-task"
  description = "Batch task: outbound to the database and to S3 only."
  vpc_id      = var.vpc_id

  # Postgres to the RDS security group itself, not to a CIDR: the rule follows
  # the database wherever bootstrap-floci puts it.
  egress {
    description     = "Postgres to the database"
    from_port       = local.db_port
    to_port         = local.db_port
    protocol        = "tcp"
    security_groups = [var.db_security_group_id]
  }

  # S3 is read and written through its public endpoint, so the task needs
  # ordinary HTTPS egress. There is no S3 VPC endpoint in this stack yet.
  egress {
    description = "HTTPS to S3"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_ecs_task_definition" "app" {
  family                   = "${local.name_prefix}-app"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc" # one ENI per task; no host networking on Fargate
  cpu                      = var.task_cpu
  memory                   = var.task_memory

  # Two roles with two different jobs (iam.tf):
  #   execution -> the ECS agent: pull image, open log stream, read the secret
  #   task      -> the app code itself: read and write the bucket
  execution_role_arn = aws_iam_role.task_execution.arn
  task_role_arn      = aws_iam_role.task.arn

  container_definitions = jsonencode([
    {
      name      = "app"
      image     = "${aws_ecr_repository.app.repository_url}:${var.image_tag}"
      essential = true

      # Plain config. BUCKET_NAME is generated by locals.tf, so it is never
      # typed by hand and can never disagree with the bucket that exists.
      environment = [
        { name = "RUN_MODE", value = "daily" },
        { name = "BUCKET_NAME", value = local.bucket_name },
      ]

      # Credentials are never in the task definition. Secrets Manager holds one
      # JSON object; `:<key>::` picks a field from it, so ECS resolves the value
      # at start time and it never lands in Terraform state or the ECS API.
      # Note the key names: the JSON says dbname/username, the app wants
      # DB_NAME/DB_USER.
      secrets = [
        { name = "DB_HOST", valueFrom = "${var.db_secret_arn}:host::" },
        { name = "DB_PORT", valueFrom = "${var.db_secret_arn}:port::" },
        { name = "DB_NAME", valueFrom = "${var.db_secret_arn}:dbname::" },
        { name = "DB_USER", valueFrom = "${var.db_secret_arn}:username::" },
        { name = "DB_PASSWORD", valueFrom = "${var.db_secret_arn}:password::" },
      ]
    }
  ])
}

output "cluster_name" {
  description = "Cluster the dispatcher Lambda calls RunTask on (3.6)."
  value       = aws_ecs_cluster.app.name
}
